<?xml version="1.0" ?>
<openbox_menu>
<menu id="root-menu" label="">
  <item label="Web browser"><action name="Execute" command="firefox" /></item>
  <item label="Terminal"><action name="Execute" command="wezterm" /></item>
  <separator />
  <!-- <menu id="kbdlayout
  -menu" label="Keyboard Layout" command="python3 ~/.config/labwc/pipe-menu.py layout" /> -->
  <menu id="daemon-menu" label="Daemons">
    <menu id="daemon-bar-menu" label="Bar">
      <item label="Start"><action name="Execute" command="yambar" /></item>
      <item label="Stop"><action name="Execute" command="pkill yambar" /></item>
    </menu>
    <menu id="daemon-bar-menu" label="Night Light">
      <item label="Start"><action name="Execute" command="wlsunset -l $WLSUNSET_LATITUDE -L $WLSUNSET_LONGITUDE" /></item>
      <item label="Stop"><action name="Execute" command="pkill wlsunset" /></item>
    </menu>
    <menu id="daemon-bar-menu" label="Background">
      <item label="Start"><action name="Execute" command="wpaperd" /></item>
      <item label="Stop"><action name="Execute" command="pkill wpaperd" /></item>
    </menu>
  </menu>
  <item label="Reconfigure"><action name="Reconfigure" /></item>
  <separator />
  <menu id="login-menu" label="Login">
    <item label="Exit"><action name="Exit" /></item>
    <item label="Suspend"><action name="Execute" command="systemctl suspend" /></item>
    <item label="Shutdown">
    <action name="Execute" command="bash ~/.config/labwc/ask-shutdown.sh" /></item>
  </menu>
</menu>
</openbox_menu>
